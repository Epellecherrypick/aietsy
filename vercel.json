{
  "version": 2,
  "projects": [
    {
      "name": "aietsy-frontend",
      "path": "frontend",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "framework": "vite"
    },
    {
      "name": "aietsy-backend",
      "path": "backend",
      "buildCommand": "npm install",
      "outputDirectory": ".",
      "framework": "express"
    }
  ],
  "build": {
    "buildCommand": "cd frontend && npm run build && cd ../backend && npm install"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-backend-url.vercel.app/api/:path*"
    }
  ],
  "routes": [
    {
      "src": "^/.*",
      "dest": "/index.html",
      "status": 200
    }
  ]
}
